# Copy to .env beside compose.yaml and fill in. .env is never committed.

# Database password. Letters and digits only (it goes into a URL), at least 24.
# Make one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# dev, test or prod. The test server uses test (the header shows TEST).
APP_ENV=test

# Port the server listens on (Traefik).
HTTP_PORT=8088

# Image tag to build and run.
NETTOP_TAG=dev
