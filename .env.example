# Local development settings. Copy to .env (gitignored): `cp .env.example .env`.
# The Go commands (cmd/api, cmd/db, cmd/testserver), the Go database tests, and
# Playwright load .env automatically; a variable already set in the environment wins.

# The development database created by compose.yaml.
DATABASE_URL=postgres://nettop:nettop-local@127.0.0.1:55432/nettop?sslmode=disable

# Database for `go test` and Playwright. Tests create and drop their own schemas,
# so the development database can be reused. Leave unset to skip database tests.
TEST_DATABASE_URL=postgres://nettop:nettop-local@127.0.0.1:55432/nettop?sslmode=disable

# Optional: API listen address (default 127.0.0.1:8080).
# HTTP_ADDR=127.0.0.1:8080

# Required by cmd/api, which refuses to start without it: dev, test or prod.
# The header shows a DEV or TEST badge; production shows none. Deployments set
# it themselves (test or prod per namespace); cmd/testserver always reports dev.
APP_ENV=dev
